# ==============================================
# 1. C++ COMPILED FILES
# ==============================================

# Executables
*.exe
*.out
*.app

# Object files
*.o
*.obj
*.lo

# Libraries
*.a
*.lib
*.dll
*.so
*.dylib

# Debug symbols
*.pdb
*.ilk
*.dSYM/


# ==============================================
# 2. BUILD DIRECTORIES
# ==============================================

build/
bin/
obj/
Debug/
Release/
cmake-build-*/


# ==============================================
# 3. VS CODE
# ==============================================

# Personal editor settings
.vscode/*

# Keep useful shared configurations
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


# ==============================================
# 4. CMAKE GENERATED FILES
# ==============================================

CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json


# ==============================================
# 5. TEMPORARY FILES
# ==============================================

*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~
*.stackdump


# ==============================================
# 6. OPERATING SYSTEM FILES
# ==============================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*/


